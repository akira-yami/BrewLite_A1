PORT=3001
WEB_ORIGIN=http://localhost:3000
# Optional: exact trusted reverse-proxy IPs/CIDRs, comma-separated. Leave empty for direct traffic.
# Never use wildcard, 0.0.0.0/0 or ::/0; configure only ingress hops controlled by your team.
TRUSTED_PROXY_CIDRS=
DATABASE_URL=postgresql://brewlite:change_me_local_only@localhost:5432/brewlite?schema=public
DATABASE_URL_DOCKER=postgresql://brewlite:change_me_local_only@postgres:5432/brewlite?schema=public

# Required: generate a random secret as described in README.md before starting.
JWT_SECRET=replace_with_random_96_character_hex_secret_generated_as_described_in_README
JWT_ISSUER=brewlite-api
JWT_AUDIENCE=brewlite-web
JWT_EXPIRES_IN=15m
ORDER_RESERVATION_TTL_MINUTES=15


# VNPay is disabled by default. Never commit real merchant credentials.
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# Trusted fixed egress IP of the API host for QueryDr; never use the browser/client IP.
# Railway hobby plan does not assign a Static Outbound IP — leave empty to disable QueryDr
# recovery; IPN settlement still works normally without this variable.
VNPAY_QUERY_SERVER_IP=
VNPAY_RETURN_URL=https://api.example.com/api/v1/payments/vnpay/return
VNPAY_IPN_URL=https://api.example.com/api/v1/payments/vnpay/ipn
