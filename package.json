{
  "name": "brewlite",
  "version": "1.0.0",
  "private": true,
  "description": "BrewLite Workspace",
  "scripts": {
    "env:local": "powershell -ExecutionPolicy Bypass -File ./scripts/switch-env.ps1 local",
    "env:prod": "powershell -ExecutionPolicy Bypass -File ./scripts/switch-env.ps1 prod",
    "env:status": "powershell -ExecutionPolicy Bypass -File ./scripts/switch-env.ps1 status",
    "dev:api": "npm run start:dev --prefix apps/api",
    "dev:web": "npm run dev --prefix apps/web",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:db": "docker compose up -d postgres",
    "docker:status": "docker compose ps",
    "docker:logs": "docker compose logs -f",
    "docker:seed": "docker compose --profile demo run --rm seed",
    "test": "npm run test:api && npm run test:web",
    "test:api": "npm test --prefix apps/api",
    "test:web": "npm test --prefix apps/web",
    "test:integration": "npm run test:integration --prefix apps/api",
    "test:demo": "powershell -ExecutionPolicy Bypass -File ./scripts/test-demo.ps1",
    "test:unit": "npm run test:api && npm run test:web",
    "perf:seed": "node ./scripts/seed-perf-nfr01.mjs",
    "perf:test": "node ./scripts/run-load-test-nfr01.mjs",
    "zip": "powershell -ExecutionPolicy Bypass -File ./scripts/zip-project.ps1"
  }
}

