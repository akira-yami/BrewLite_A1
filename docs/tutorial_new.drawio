        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\ntitle Activity Diagram - Thêm món vào giỏ hàng\n\n|Khách hàng|\n\nstart\n\n:Chọn món;\n\n:Chọn tùy chọn món;\n\n:Nhập số lượng;\n\n|Hệ thống|\n\n:Kiểm tra tình trạng món;\n\nif (Món hợp lệ?) then (Có)\n\n    :Lấy giỏ hàng hiện tại;\n\n    if (Giỏ hàng tồn tại?) then (Có)\n\n    else (Chưa có)\n        :Tạo giỏ hàng mới;\n    endif\n\n    :Kiểm tra món đã có trong giỏ;\n\n    if (Đã có trong giỏ?) then (Có)\n        :Cộng số lượng vào món trong giỏ;\n    else (Chưa có)\n        :Thêm món vào giỏ;\n    endif\n\n    :Tính lại tổng tiền giỏ hàng;\n\n    :Hiển thị giỏ hàng;\n\n    stop\n\nelse (Không)\n\n    :Thông báo món không khả dụng;\n\n    |Khách hàng|\n\n    :Chọn món khác;\n\n    |Hệ thống|\n\n    :Kiểm tra tình trạng món;\n\nendif\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="1HkUQSF4sP_Wi9oWnGg8-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
