  <diagram id="np6g641yNCruLawrPBQq" name="System Architecture">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle SD-02 - BrewLite System Architecture\n\ntop to bottom direction\n\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam componentStyle rectangle\nskinparam packageStyle rectangle\nskinparam linetype ortho\nskinparam defaultFontName Arial\nskinparam nodesep 25\nskinparam ranksep 35\n\nskinparam component {\n  BackgroundColor #EFF6FF\n  BorderColor #0284C7\n}\n\nskinparam database {\n  BackgroundColor #F0FDF4\n  BorderColor #16A34A\n}\n\nskinparam ArrowColor #475569\n\n&#39; FRONTEND\npackage \&quot;Frontend - Next.js\&quot; {\n  component \&quot;Customer UI\\nMenu / Cart / Checkout\&quot; as UI\n}\n\n&#39; BACKEND\npackage \&quot;Backend - NestJS\&quot; {\n\n  component \&quot;REST API\\nJWT / Validation\&quot; as API\n\n  package \&quot;Business Modules\&quot; {\n    component \&quot;Auth\&quot; as Auth\n    component \&quot;Catalog\&quot; as Catalog\n    component \&quot;Orders\&quot; as Orders\n    component \&quot;Payments\&quot; as Payments\n    component \&quot;Inventory\&quot; as Inventory\n    component \&quot;Coupons\&quot; as Coupons\n    component \&quot;Loyalty\&quot; as Loyalty\n  }\n\n  component \&quot;Prisma ORM\&quot; as Prisma\n}\n\n&#39; INFRASTRUCTURE\ndatabase \&quot;PostgreSQL\&quot; as DB\ncloud \&quot;Mock Payment Gateway\&quot; as Gateway\n\n&#39; CONNECTIONS\nUI --&gt; API : HTTPS / JSON\n\nAPI --&gt; Auth\nAPI --&gt; Catalog\nAPI --&gt; Orders\nAPI --&gt; Payments\nAPI --&gt; Inventory\nAPI --&gt; Coupons\nAPI --&gt; Loyalty\n\nAuth -[hidden]right- Catalog\nCatalog -[hidden]right- Orders\nOrders -[hidden]right- Payments\nInventory -[hidden]right- Coupons\nCoupons -[hidden]right- Loyalty\n\nOrders --&gt; Prisma\nPrisma --&gt; DB : SQL\n\nPayments --&gt; Gateway : Payment API\n\nnote right of Prisma\n  Các module truy cập\n  database qua Prisma\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="VsGhDGGSkmxTnw-kPBVr-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
