# BrewLite - example environment variables
# Không đặt secret thật vào file này.

NODE_ENV=development
WEB_PORT=3000
API_PORT=3001
POSTGRES_PORT=5432
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
WEB_ORIGIN=http://localhost:3000

POSTGRES_DB=brewlite
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgresql://brewlite:change_me_local_only@postgres:5432/brewlite?schema=public
# Bắt buộc cho docker compose (migrate và backend). Dùng host "postgres" trong mạng Docker
# và cùng user/password/db với POSTGRES_* ở trên.
DATABASE_URL_DOCKER=postgresql://brewlite:change_me_local_only@postgres:5432/brewlite?schema=public

# Bắt buộc: tạo secret ngẫu nhiên riêng rồi điền vào .env, không commit secret.
JWT_SECRET=
JWT_ISSUER=brewlite-api
JWT_AUDIENCE=brewlite-web
JWT_EXPIRES_IN=15m

MOCK_PAYMENT_MODE=deterministic
ORDER_RESERVATION_TTL_MINUTES=15
