        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle SD-04 - BrewLite Order State Machine\n\nleft to right direction\nhide empty description\n\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam linetype ortho\nskinparam ArrowColor #475569\nskinparam state {\n  BackgroundColor #EFF6FF\n  BorderColor #0284C7\n  FontColor #0F172A\n  FontSize 13\n  AttributeFontSize 12\n  StartColor #475569\n  EndColor #475569\n}\n\nstate PENDING #FFF4DF\nstate PAID #DBEAFE\nstate PREPARING #DBEAFE\nstate READY #DBEAFE\nstate COMPLETED #DCFCE7\nstate PAYMENT_FAILED #FEE2E2\nstate CANCELLED #E5E7EB\n\n&#39; Initial state\n[*] --&gt; PENDING : Tạo đơn hàng\n\n&#39; Happy path\nPENDING --&gt; PAID : Thanh toán thành công\nPAID --&gt; PREPARING : Barista nhận đơn\nPREPARING --&gt; READY : Pha chế xong\nREADY --&gt; COMPLETED : Giao đồ uống\n\n&#39; Payment failure and retry\nPENDING -down-&gt; PAYMENT_FAILED : Thanh toán thất bại\nPAYMENT_FAILED -up-&gt; PENDING : Thử thanh toán lại\n\n&#39; Cancellation\nPENDING --&gt; CANCELLED : Hủy đơn\nPAYMENT_FAILED --&gt; CANCELLED : Hủy đơn\nPAID --&gt; CANCELLED : Hủy đơn\n\n&#39; Final states\nCOMPLETED --&gt; [*]\nCANCELLED --&gt; [*]\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="4ffezAIIOuj94nHUwb2M-1">
