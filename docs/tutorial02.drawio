        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\n\nactor \&quot;Khách hàng\&quot; as Customer\nactor \&quot;Hệ thống Thanh toán\&quot; as PaymentGateway\nactor \&quot;Đơn vị Vận chuyển\&quot; as Shipper\n\nrectangle \&quot;Hệ thống Xử lý Đơn hàng\&quot; {\n    usecase \&quot;Đặt hàng (Order Placed)\&quot; as UC_PlaceOrder\n    usecase \&quot;Tiếp nhận &amp; Kiểm tra thông tin\&quot; as UC_CheckOrder\n    usecase \&quot;Xử lý thanh toán\&quot; as UC_Payment\n    usecase \&quot;Thanh toán qua Thẻ tín dụng\&quot; as UC_CC\n    usecase \&quot;Thanh toán qua PayPal\&quot; as UC_PayPal\n    usecase \&quot;Thanh toán qua Chuyển khoản\&quot; as UC_Bank\n    usecase \&quot;Xử lý đơn (Fulfill Order)\&quot; as UC_Fulfill\n    usecase \&quot;Giao hàng (Shipping Order)\&quot; as UC_Ship\n    usecase \&quot;Hoàn tất đơn hàng (Complete Order)\&quot; as UC_Complete\n    usecase \&quot;Từ chối đơn hàng (Reject Order)\&quot; as UC_Reject\n}\n\n&#39; Tác nhân chính\nCustomer --&gt; UC_PlaceOrder\n\n&#39; Luồng chính (Include)\nUC_PlaceOrder .&gt; UC_CheckOrder : &lt;&lt;include&gt;&gt;\nUC_CheckOrder .&gt; UC_Payment : &lt;&lt;include&gt;&gt;\n\n&#39; Phương thức thanh toán (Generalization)\nUC_CC --|&gt; UC_Payment\nUC_PayPal --|&gt; UC_Payment\nUC_Bank --|&gt; UC_Payment\n\n&#39; Tác nhân hỗ trợ thanh toán\nUC_Payment --&gt; PaymentGateway\n\n&#39; Luồng xử lý sau thanh toán\nUC_Payment .&gt; UC_Fulfill : &lt;&lt;include&gt;&gt;\nUC_Fulfill .&gt; UC_Ship : &lt;&lt;include&gt;&gt;\n\n&#39; Tác nhân vận chuyển\nUC_Ship --&gt; Shipper\nUC_Ship .&gt; UC_Complete : &lt;&lt;include&gt;&gt;\n\n&#39; Các luồng ngoại lệ / sự kiện phụ (Extend)\nUC_CheckOrder &lt;.. UC_Reject : &lt;&lt;extend&gt;&gt;\\n(A1: Thông tin không hợp lệ)\nUC_Payment &lt;.. UC_Reject : &lt;&lt;extend&gt;&gt;\\n(A2: Thanh toán thất bại)\nUC_Ship &lt;.. UC_Reject : &lt;&lt;extend&gt;&gt;\\n(A3: Giao hàng thất bại)\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="bRkm85xVRQnGCGkgwoiC-14">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
