        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\n\ntitle ONLINE ORDER PROCESSING SYSTEM\\nActivity Diagram - Swimlanes\n\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam defaultFontName Arial\n\n|Customer|\nstart\n:Order Placed;\n\n|Order System|\n:Receive order;\n\n&#39; Parallel validation\nfork\n  :Validate Order;\nfork again\n  |Payment Service|\n  :Validate Payment Information;\nend fork\n\n|Order System|\nif (Order details valid?) then (Valid order details)\n\n  :Process Payment;\n\n  |Payment Service|\n  switch (Payment method?)\n    case (Credit Card)\n      :Process credit card payment;\n    case (PayPal)\n      :Process PayPal payment;\n    case (Bank Transfer)\n      :Process bank transfer payment;\n  endswitch\n\n  |Order System|\n  -&gt; Processing Payment;\n\n  if (Payment status?) then (Payment Done)\n\n    :Fulfill Order;\n\n    |Shipping Service|\n    :Shipping Order;\n\n    |Order System|\n    if (Shipping result?) then (Ship Success)\n      :Complete order;\n      goto completed\n    else (Shipping failed)\n    endif\n\n  else (Payment Failed)\n  endif\n\nelse (Invalid order details)\nendif\n\n|Order System|\n:Reject Order;\n\nlabel completed\nstop\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="EWt8hbXbvWkeWUaw8Ihl-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
