        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\nskinparam responseMessageBelowArrow true\nskinparam BoxPadding 10\n\nactor \&quot;Khách hàng\&quot; as User\n\nbox \&quot;Frontend (apps/web)\&quot; #WhiteSmoke\n    participant \&quot;ProductDetailModal\\n(features/catalog/components)\&quot; as Modal\n    participant \&quot;useProductDetailQuery\\n(features/catalog/queries)\&quot; as Hook\nend box\n\nbox \&quot;Backend (apps/api - CatalogModule)\&quot; #AliceBlue\n    participant \&quot;CatalogController\\n(controllers)\&quot; as Controller\n    participant \&quot;CatalogService\\n(services)\&quot; as Service\n    participant \&quot;CatalogRepository\\n(repositories)\&quot; as Repo\n    participant \&quot;CatalogMapper\\n(mappers)\&quot; as Mapper\nend box\n\ndatabase \&quot;PostgreSQL\\n(Prisma ORM)\&quot; as DB\n\nUser -&gt; Modal: Bấm chọn 1 món trên Menu (productId)\nactivate Modal\nModal -&gt; Modal: Mở Modal (State: modalLoading = true)\nModal --&gt; User: Hiển thị hiệu ứng tải dữ liệu trong popup\n\nModal -&gt; Hook: useProductDetailQuery(productId)\nactivate Hook\nHook -&gt; Controller: GET /api/v1/products/{id}\nactivate Controller\n\nController -&gt; Service: getProductDetailById(id)\nactivate Service\n\nService -&gt; Repo: findDetailById(id)\nactivate Repo\n\nRepo -&gt; DB: prisma.product.findFirst({\\n  where: { id, isActive: true },\\n  include: {\\n    variants: { where: { isActive: true } },\\n    productToppings: { include: { topping: true } }\\n  }\\n})\nactivate DB\nDB --&gt; Repo: Bản ghi chi tiết món (hoặc null)\ndeactivate DB\n\nRepo --&gt; Service: ProductDetail Entity | null\ndeactivate Repo\n\nalt [product == null (Không tìm thấy hoặc isActive = false)]\n    Service -&gt; Controller: throw NotFoundException(&#39;Product not found&#39;)\n    Controller --&gt; Hook: 404 Not Found (Error Response)\n    Hook --&gt; Modal: Return state: { isError: true, error }\n    Modal --&gt; User: Hiển thị thông báo \&quot;Món đã ngưng bán hoặc không tồn tại\&quot;\nelse [product != null (Tìm thấy sản phẩm)]\n    Service -&gt; Mapper: toProductDetailResponseDto(entity)\n    activate Mapper\n    Mapper --&gt; Service: ProductDetailResponseDto (gồm cờ tồn kho/isOutOfStock)\n    deactivate Mapper\n    \n    Service --&gt; Controller: ProductDetailResponseDto\n    deactivate Service\n    \n    Controller --&gt; Hook: 200 OK (JSON ProductDetail)\n    deactivate Controller\n    \n    Hook --&gt; Modal: Return state: { data: productDetail, isLoading: false }\n    deactivate Hook\n    \n    Modal --&gt; User: Hiển thị thông tin món, danh sách Size &amp; Topping\\n(Nếu hết hàng -&gt; Disable nút đặt hàng)\n    deactivate Modal\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="pk-vbGZmd0I0tBHbD3ec-94">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
