        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml SD-07B_Get_Product_Detail\nautonumber\nskinparam responseMessageBelowArrow true\nskinparam style strictuml\nskinparam BoxPadding 10\nskinparam ParticipantPadding 10\n\nactor \&quot;Customer\&quot; as User\n\nbox \&quot;Frontend (apps/web)\&quot; #F8F9FA\n    participant \&quot;ProductDetailModal\\n(components/catalog)\&quot; as Modal\n    participant \&quot;useProductDetailQuery\\n(TanStack Query)\&quot; as Query\nend box\n\nbox \&quot;Backend (apps/api - CatalogModule)\&quot; #EBF5FB\n    participant \&quot;CatalogController\&quot; as Controller\n    participant \&quot;CatalogService\&quot; as Service\n    participant \&quot;CatalogRepository\&quot; as Repo\n    participant \&quot;CatalogMapper\&quot; as Mapper\nend box\n\ndatabase \&quot;PostgreSQL\\n(Prisma ORM)\&quot; as DB\n\n== Khách chọn xem chi tiết món ==\n\nUser -&gt; Modal: Bấm chọn 1 món trên Menu (productId)\nactivate Modal\n\nModal -&gt; Modal: Mở Modal (State: modalLoading = true)\nModal --&gt; User: Hiển thị hiệu ứng tải dữ liệu trong popup\n\nModal -&gt; Query: useProductDetailQuery(productId)\nactivate Query\n\nQuery -&gt; Controller: GET /api/v1/products/{id}\nactivate Controller\n\nController -&gt; Service: getProductDetailById(id)\nactivate Service\n\nService -&gt; Repo: findByIdWithToppingsAndVariants(id)\nactivate Repo\n\nRepo -&gt; DB: prisma.product.findUnique({\\n  where: { id, isActive: true },\\n  include: { variants: true, toppings: true }\\n})\nactivate DB\nDB --&gt; Repo: Bản ghi chi tiết món (hoặc null)\ndeactivate DB\n\nRepo --&gt; Service: ProductDetailEntity | null\ndeactivate Repo\n\nalt Sản phẩm tồn tại &amp; khả dụng\n    Service -&gt; Mapper: toProductDetailResponseDto(entity)\n    activate Mapper\n    Mapper --&gt; Service: ProductDetailResponseDto (packages/contracts)\n    deactivate Mapper\n\n    Service --&gt; Controller: ProductDetailResponseDto\n    Controller --&gt; Query: 200 OK (JSON ProductDetail)\n    Query -&gt; Modal: Return state: { data: productDetail, isLoading: false }\n    Modal --&gt; User: Hiển thị thông tin món, danh sách Size &amp; Topping để chọn\n\nelse Sản phẩm không tồn tại / đã bị ẩn (Not Found)\n    Service --&gt; Controller: throw NotFoundException(&#39;Product not found&#39;)\n    deactivate Service\n\n    Controller --&gt; Query: 404 Not Found (Error Response)\n    deactivate Controller\n\n    Query -&gt; Modal: Return state: { isError: true, error }\n    deactivate Query\n\n    Modal --&gt; User: Hiển thị thông báo \&quot;Món đã ngưng bán hoặc không tồn tại\&quot;\nend\ndeactivate Modal\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="q9bci2sFUhYN3GMVZOUQ-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
