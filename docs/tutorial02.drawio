        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\nleft to right direction\n\nskinparam packageStyle rectangle\nskinparam actorStyle stickman\n\n&#39; =========================\n&#39; Tác nhân bên trái\n&#39; =========================\n\nactor Customer\n\n&#39; =========================\n&#39; System Boundary\n&#39; =========================\n\nrectangle \&quot;«Business»Online Shopping\&quot; {\n\n    usecase \&quot;Search Product\&quot; as SearchProduct\n    usecase \&quot;Search by Category\&quot; as SearchCategory\n    usecase \&quot;Search by Name\&quot; as SearchName\n\n    usecase \&quot;Manage Cart\&quot; as ManageCart\n    usecase \&quot;Add to Cart\&quot; as AddCart\n    usecase \&quot;Edit cart\&quot; as EditCart\n\n    usecase \&quot;Check Out\&quot; as CheckOut\n    usecase \&quot;Make Payment\&quot; as MakePayment\n    usecase \&quot;Confirm Order\&quot; as ConfirmOrder\n}\n\n&#39; =========================\n&#39; Tác nhân bên phải\n&#39; =========================\n\nactor \&quot;Payment Gateway\&quot; as PaymentGateway\nactor \&quot;Shipping Company\&quot; as ShippingCompany\n\n&#39; =========================\n&#39; Customer associations\n&#39; =========================\n\nCustomer --&gt; SearchProduct\nCustomer --&gt; ManageCart\nCustomer --&gt; CheckOut\n\n&#39; =========================\n&#39; Search relationships\n&#39; =========================\n\nSearchCategory ..&gt; SearchProduct : &lt;&lt;extend&gt;&gt;\nSearchName ..&gt; SearchProduct : &lt;&lt;extend&gt;&gt;\n\n&#39; =========================\n&#39; Cart relationships\n&#39; =========================\n\nAddCart --|&gt; ManageCart\nEditCart --|&gt; ManageCart\n\n&#39; =========================\n&#39; Checkout &amp; Payment\n&#39; =========================\n\nCheckOut ..&gt; MakePayment : &lt;&lt;include&gt;&gt;\n\nPaymentGateway --&gt; MakePayment : +Process\n\n&#39; =========================\n&#39; Confirm Order\n&#39; =========================\n\nConfirmOrder ..&gt; MakePayment : +depends\n\nShippingCompany --&gt; ConfirmOrder : +Shipped product\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="z1aZ9Orudw7HveQGVDl0-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
