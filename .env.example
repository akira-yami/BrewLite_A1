# BrewLite - example environment variables
# Không đặt secret thật vào file này.

NODE_ENV=development
WEB_PORT=3000
API_PORT=3001
POSTGRES_PORT=5432
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
WEB_ORIGIN=http://localhost:3000

POSTGRES_DB=brewlite
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgresql://brewlite:change_me_local_only@postgres:5432/brewlite?schema=public
# Bắt buộc cho docker compose (migrate và backend). Dùng host "postgres" trong mạng Docker
# và cùng user/password/db với POSTGRES_* ở trên.
DATABASE_URL_DOCKER=postgresql://brewlite:change_me_local_only@postgres:5432/brewlite?schema=public

# Bắt buộc: tạo secret ngẫu nhiên riêng rồi điền vào .env, không commit secret.
JWT_SECRET=
JWT_ISSUER=brewlite-api
JWT_AUDIENCE=brewlite-web
JWT_EXPIRES_IN=15m

# Seed tạo customer01 / Customer@123 và barista01 / Barista@123.

# MOCK_PAYMENT_MODE: bỏ trống để mock gateway chạy random (80% thành công, delay 1-2s).
# Chỉ đặt "deterministic" khi chạy automated E2E tests (CI tự set, không cần điền tay).
ORDER_RESERVATION_TTL_MINUTES=15

# VNPay integration (tuỳ chọn - để trống khi dùng Mock Gateway)
# NEXT_PUBLIC_VNPAY_ENABLED=true # Cho phép hiển thị phương thức VNPay trên giao diện Web Checkout
# VNPAY_ENABLED=true
# VNPAY_TMN_CODE=           # 8 ký tự alphanumeric do VNPay cấp
# VNPAY_HASH_SECRET=        # tối thiểu 32 ký tự do VNPay cấp
# VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# VNPAY_RETURN_URL=https://<your-api-domain>/api/v1/payments/vnpay/return
# VNPAY_IPN_URL=https://<your-api-domain>/api/v1/payments/vnpay/ipn
# VNPAY_QUERY_SERVER_IP=    # IP egress tĩnh của API server (dùng cho QueryDr recovery).
#                           # Railway hobby plan không cấp Static Outbound IP — bỏ trống để
#                           # tắt QueryDr; IPN vẫn hoạt động bình thường khi thiếu biến này.
