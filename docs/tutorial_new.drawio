  <diagram id="-WVfz7rUqRPa_C7xdvLQ" name="ERD">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle BrewLite - Entity Relationship Diagram\n\nhide circle\nhide methods\n\nskinparam shadowing false\nskinparam linetype ortho\nskinparam defaultFontName Arial\nskinparam nodesep 40\nskinparam ranksep 55\n\nskinparam entity {\n  BackgroundColor #FFFFFF\n  BorderColor #168AD5\n  FontColor #17324D\n}\n\nskinparam ArrowColor #478EB9\n\n&#39; ===========================\n&#39; USERS\n&#39; ===========================\nentity \&quot;users\&quot; as users {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  username : VARCHAR(100) &lt;&lt;UK&gt;&gt;\n  password_hash : VARCHAR(255)\n  role : UserRole\n  loyalty_balance : INT\n  is_active : BOOLEAN\n  created_at : TIMESTAMPTZ\n  updated_at : TIMESTAMPTZ\n}\n\n&#39; ===========================\n&#39; PRODUCTS\n&#39; ===========================\nentity \&quot;products\&quot; as products {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  sku : VARCHAR(50) &lt;&lt;UK&gt;&gt;\n  name : VARCHAR(150)\n  description : TEXT\n  base_price : BIGINT\n  image_url : VARCHAR(500)\n  is_active : BOOLEAN\n  created_at : TIMESTAMPTZ\n  updated_at : TIMESTAMPTZ\n}\n\n&#39; ===========================\n&#39; PRODUCT VARIANTS\n&#39; ===========================\nentity \&quot;product_variants\&quot; as product_variants {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  product_id : UUID &lt;&lt;FK&gt;&gt;\n  size : ProductSize\n  price_delta : BIGINT\n  stock : INT\n  version : INT\n  is_active : BOOLEAN\n  created_at : TIMESTAMPTZ\n  updated_at : TIMESTAMPTZ\n}\n\n&#39; ===========================\n&#39; TOPPINGS\n&#39; ===========================\nentity \&quot;toppings\&quot; as toppings {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  code : VARCHAR(50) &lt;&lt;UK&gt;&gt;\n  name : VARCHAR(100)\n  price : BIGINT\n  is_active : BOOLEAN\n  created_at : TIMESTAMPTZ\n  updated_at : TIMESTAMPTZ\n}\n\n&#39; ===========================\n&#39; PRODUCT TOPPINGS\n&#39; ===========================\nentity \&quot;product_toppings\&quot; as product_toppings {\n  * product_id : UUID &lt;&lt;PK, FK&gt;&gt;\n  * topping_id : UUID &lt;&lt;PK, FK&gt;&gt;\n}\n\n&#39; ===========================\n&#39; ORDERS\n&#39; ===========================\nentity \&quot;orders\&quot; as orders {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  order_number : VARCHAR(30) &lt;&lt;UK&gt;&gt;\n  user_id : UUID &lt;&lt;FK&gt;&gt;\n  status : OrderStatus\n  subtotal : BIGINT\n  discount_amount : BIGINT\n  total : BIGINT\n  currency : VARCHAR(3)\n  coupon_code_snapshot : VARCHAR(50)\n  created_at : TIMESTAMPTZ\n  updated_at : TIMESTAMPTZ\n}\n\n&#39; ===========================\n&#39; ORDER ITEMS\n&#39; ===========================\nentity \&quot;order_items\&quot; as order_items {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  order_id : UUID &lt;&lt;FK&gt;&gt;\n  product_variant_id : UUID &lt;&lt;FK&gt;&gt;\n  product_name_snapshot : VARCHAR(150)\n  variant_name_snapshot : VARCHAR(50)\n  unit_price : BIGINT\n  quantity : INT\n  line_total : BIGINT\n}\n\n&#39; ===========================\n&#39; ORDER ITEM TOPPINGS\n&#39; ===========================\nentity \&quot;order_item_toppings\&quot; as order_item_toppings {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  order_item_id : UUID &lt;&lt;FK&gt;&gt;\n  topping_id : UUID &lt;&lt;FK&gt;&gt;\n  topping_name_snapshot : VARCHAR(100)\n  unit_price : BIGINT\n  quantity : INT\n  line_total : BIGINT\n}\n\n&#39; ===========================\n&#39; PAYMENTS\n&#39; ===========================\nentity \&quot;payments\&quot; as payments {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  order_id : UUID &lt;&lt;FK&gt;&gt;\n  idempotency_key : VARCHAR(100) &lt;&lt;UK&gt;&gt;\n  request_hash : CHAR(64)\n  method : PaymentMethod\n  status : PaymentStatus\n  amount : BIGINT\n  gateway_transaction_id : VARCHAR(100) &lt;&lt;UK&gt;&gt;\n  failure_code : VARCHAR(100)\n  processed_at : TIMESTAMPTZ\n  created_at : TIMESTAMPTZ\n  updated_at : TIMESTAMPTZ\n}\n\n&#39; ===========================\n&#39; ORDER STATUS HISTORIES\n&#39; ===========================\nentity \&quot;order_status_histories\&quot; as order_status_histories {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  order_id : UUID &lt;&lt;FK&gt;&gt;\n  from_status : OrderStatus\n  to_status : OrderStatus\n  changed_by_user_id : UUID &lt;&lt;FK&gt;&gt;\n  source : VARCHAR(30)\n  reason : VARCHAR(255)\n  created_at : TIMESTAMPTZ\n}\n\n&#39; ===========================\n&#39; INVENTORY RESERVATIONS\n&#39; ===========================\nentity \&quot;inventory_reservations\&quot; as inventory_reservations {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  order_id : UUID &lt;&lt;FK&gt;&gt;\n  product_variant_id : UUID &lt;&lt;FK&gt;&gt;\n  quantity : INT\n  status : ReservationStatus\n  expires_at : TIMESTAMPTZ\n  created_at : TIMESTAMPTZ\n  updated_at : TIMESTAMPTZ\n}\n\n&#39; ===========================\n&#39; COUPONS\n&#39; ===========================\nentity \&quot;coupons\&quot; as coupons {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  code : VARCHAR(50) &lt;&lt;UK&gt;&gt;\n  discount_type : DiscountType\n  discount_value : BIGINT\n  max_discount : BIGINT\n  min_order_value : BIGINT\n  usage_limit : INT\n  per_user_limit : INT\n  starts_at : TIMESTAMPTZ\n  ends_at : TIMESTAMPTZ\n  is_active : BOOLEAN\n  created_at : TIMESTAMPTZ\n  updated_at : TIMESTAMPTZ\n}\n\n&#39; ===========================\n&#39; COUPON REDEMPTIONS\n&#39; ===========================\nentity \&quot;coupon_redemptions\&quot; as coupon_redemptions {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  coupon_id : UUID &lt;&lt;FK&gt;&gt;\n  user_id : UUID &lt;&lt;FK&gt;&gt;\n  order_id : UUID &lt;&lt;FK, UK&gt;&gt;\n  discount_amount : BIGINT\n  status : CouponRedemptionStatus\n  expires_at : TIMESTAMPTZ\n  consumed_at : TIMESTAMPTZ\n  released_at : TIMESTAMPTZ\n  created_at : TIMESTAMPTZ\n  updated_at : TIMESTAMPTZ\n}\n\n&#39; ===========================\n&#39; LOYALTY TRANSACTIONS\n&#39; ===========================\nentity \&quot;loyalty_transactions\&quot; as loyalty_transactions {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  user_id : UUID &lt;&lt;FK&gt;&gt;\n  order_id : UUID &lt;&lt;FK&gt;&gt;\n  type : LoyaltyTransactionType\n  points : INT\n  balance_after : INT\n  reason : VARCHAR(255)\n  created_at : TIMESTAMPTZ\n}\n\n&#39; ===========================\n&#39; RELATIONSHIPS\n&#39; ===========================\n\nusers ||--o{ orders\nusers ||--o{ coupon_redemptions\nusers ||--o{ loyalty_transactions\nusers |o--o{ order_status_histories\n\nproducts ||--|{ product_variants\nproducts ||--o{ product_toppings\ntoppings ||--o{ product_toppings\ntoppings ||--o{ order_item_toppings\n\norders ||--|{ order_items\nproduct_variants ||--o{ order_items\norder_items ||--o{ order_item_toppings\n\norders ||--o{ payments\norders ||--|{ order_status_histories\norders ||--|{ inventory_reservations\nproduct_variants ||--o{ inventory_reservations\n\ncoupons ||--o{ coupon_redemptions\norders ||--o| coupon_redemptions\norders |o--o{ loyalty_transactions\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="gyCtaNFrTvlulztT8pch-22">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;font style=&quot;font-size: 34px;&quot;&gt;BrewLite - Entity Relationship Diagram&lt;/font&gt;" plantUmlId="cltitle_2" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;fontFamily=Arial;" plantUmlBaseValue="BrewLite - Entity Relationship Diagram" id="aIvTMetp9IkURQlUNsek-2">
          <mxCell parent="gyCtaNFrTvlulztT8pch-22" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;fontFamily=Arial;" vertex="1">
            <mxGeometry height="24" width="282.05539999999996" x="679.9973" as="geometry" />
          </mxCell>
