
{
  "name": "brewlite",
  "version": "1.0.0",
  "private": true,
  "description": "BrewLite Workspace",
  "scripts": {
    "env:local": "powershell -ExecutionPolicy Bypass -File ./scripts/switch-env.ps1 local",
    "env:prod": "powershell -ExecutionPolicy Bypass -File ./scripts/switch-env.ps1 prod",
    "env:status": "powershell -ExecutionPolicy Bypass -File ./scripts/switch-env.ps1 status",
    "dev:api": "npm run start:dev --prefix apps/api",
    "dev:web": "npm run dev --prefix apps/web",
    "test:api": "node scripts/run-api-tests.mjs",
    "test:demo": "powershell -ExecutionPolicy Bypass -File ./scripts/test-demo.ps1",
    "test:unit": "npm run test --prefix apps/api -- order-state-machine.spec.ts payments-idempotency.integration.spec.ts",
    "zip": "powershell -ExecutionPolicy Bypass -File ./scripts/zip-project.ps1"
  }
}
