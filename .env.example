# BrewLite - example environment variables
# Không đặt secret thật vào file này.

NODE_ENV=development
WEB_PORT=3000
API_PORT=3001
POSTGRES_PORT=5432
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
WEB_ORIGIN=http://localhost:3000

POSTGRES_DB=brewlite
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgresql://brewlite:change_me_local_only@postgres:5432/brewlite?schema=public
# Bắt buộc cho docker compose (migrate và backend). Dùng host "postgres" trong mạng Docker
# và cùng user/password/db với POSTGRES_* ở trên.
DATABASE_URL_DOCKER=postgresql://brewlite:change_me_local_only@postgres:5432/brewlite?schema=public

# Bắt buộc: tạo secret ngẫu nhiên riêng rồi điền vào .env, không commit secret.
JWT_SECRET=
JWT_ISSUER=brewlite-api
JWT_AUDIENCE=brewlite-web
JWT_EXPIRES_IN=15mS

MOCK_PAYMENT_MODE=deterministic
ORDER_RESERVATION_TTL_MINUTES=15

# Payment provider: mock (default for CI/local) or vnpay (Sandbox only until approved).
PAYMENT_GATEWAY=mock
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=https://api.example.com/api/v1/payments/vnpay/return
VNP_IPN_URL=https://api.example.com/api/v1/payments/vnpay/ipn
WEB_PUBLIC_URL=https://web.example.com

# Optional Cloudflare Named Tunnel token. Keep private; compose profile "tunnel" reads this value.
CLOUDFLARE_TUNNEL_TOKEN=
